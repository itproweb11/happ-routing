{
  "input": [
    {
      "type": "v2rayGeoIPDat",
      "action": "add",
      "args": {
        "uri": "./upstream-geoip.dat",
        "filter": [
          "private",
          "ru"
        ]
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "russia-inside",
        "uri": "./russia-inside.txt"
      }
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip.dat"
      }
    }
  ]
}
